# Скопируйте этот файл в .env и заполните значения

# --- API ---
# Токен сервиса. Без него сайт работает в демо-режиме.
API_TOKEN=
UPSTREAM_URL=https://api.inferhold.com
# Как передавать токен: bearer или x-api-key
AUTH_HEADER=bearer

# --- сервер ---
PORT=8787
# 127.0.0.1 — только этот компьютер; 0.0.0.0 — доступ из сети
HOST=127.0.0.1
DATA_DIR=data

# --- администратор ---
# Создаётся при первом запуске. После входа смените пароль в настройках.
ADMIN_LOGIN=squledAD
ADMIN_PASSWORD=0806netU0806@
# Дополнительные админы через запятую (логины)
ADMIN_LOGINS=

# --- аккаунты ---
# false закрывает регистрацию: пользователей заводит админ
ALLOW_REGISTRATION=true
# Тариф нового аккаунта: free | pro | prem
DEFAULT_PLAN=free
# true, если сайт открыт по https
COOKIE_SECURE=false
# true, если сервер стоит за nginx или Cloudflare
TRUST_PROXY=false

# --- лимиты и цены ---
# Верхний предел размера файла (на тарифах он может быть меньше)
MAX_FILE_MB=200
MAX_HISTORY=40
# Сколько токенов стоит 1 кредит на самой дешёвой модели.
# 120000 × 500 кредитов = 60 млн токенов (тариф PRO)
TOKENS_PER_CREDIT=120000
# Во сколько раз токен ответа дороже токена запроса
OUTPUT_WEIGHT=5

# --- оплата ---
# Telegram для покупки тарифов (без @)
CONTACT_TELEGRAM=wesfw
# Скидка при оплате на год, проценты
YEAR_DISCOUNT=15
